# EvidenceFirst-RAG Environment Variables

# LLM Providers (Configure at least one for online mode; system will use Mock/Offline provider if none are provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Default LLM Provider: 'gemini', 'openai', 'groq', or 'mock'
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Embeddings & NLI Device: 'cpu' or 'cuda'
DEVICE=cpu

# Cache Directory
CACHE_DIR=./data/cache
